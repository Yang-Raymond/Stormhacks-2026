# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Generate with: openssl rand -hex 32
SESSION_SECRET=
POSTGRES_PASSWORD=

# Tiger Data (optional): use a Tiger Cloud service instead of the local db container.
# DATABASE_URL=postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require

# OAuth (optional)
# PUBLIC_URL=http://localhost:3000
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Snowflake (optional): AI hints (Cortex) and the Insights warehouse. See docs/integrations.md.
# SNOWFLAKE_ACCOUNT=myorg-myaccount
# SNOWFLAKE_TOKEN=
# SNOWFLAKE_WAREHOUSE=LADYBUG_WH
# SNOWFLAKE_DATABASE=LADYBUG
# SNOWFLAKE_SCHEMA=ANALYTICS
# SNOWFLAKE_ROLE=LADYBUG_APP
# SNOWFLAKE_CORTEX_MODEL=mistral-large2
# Salt for anonymizing user ids sent to Snowflake (openssl rand -hex 16). Required for the sync.
# ANALYTICS_SALT=
